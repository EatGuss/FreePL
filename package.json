{
  "name": "freepl",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p api",
    "test": "pnpm -r --if-present test",
    "build": "pnpm --filter web build",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "check:contract": "pnpm --filter server check:contract"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "hono": "4.13.13",
    "server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
